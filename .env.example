# Copy this file to .env and fill it in. .env is git-ignored. Never commit it.
#
# Leave GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET empty to run in LOCAL mode
# (no login, data saved to the data/ folder on this machine).

# Port the server listens on.
PORT=4317

# The public address of the app, with no trailing slash. The GitHub login
# callback is BASE_URL + /auth/callback, and it must match the
# "Callback URL" in your GitHub App settings exactly.
BASE_URL=http://localhost:4317

# ---- GitHub App (Settings > Developer settings > GitHub Apps) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's URL name, from https://github.com/apps/<slug>. Used to show
# an "Install the app" link on the setup screen.
GITHUB_APP_SLUG=

# Name of the private repo each user keeps their data in.
DATA_REPO=triage-data

# Encrypts the login cookie. 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: comma-separated GitHub usernames allowed to sign in.
# Leave empty to let anyone sign in (each person only ever sees their own repo).
ALLOWED_USERS=
